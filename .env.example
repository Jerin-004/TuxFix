# TuxFix Configuration
# Copy this file to .env and update values as needed.
# Never commit .env to version control.

# Ollama server endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model name to use (must be pulled in Ollama before use)
# Check available models with: ollama list
OLLAMA_MODEL=codegemma:2b

# Request timeout in seconds
OLLAMA_TIMEOUT=120

# Enable demo mode (true/false). When true, uses predefined sample responses.
# Demo mode never claims a real LLM generated the responses.
TUXFIX_DEMO_MODE=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
